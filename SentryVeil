#!/usr/bin/env python3

import argparse
import os
import re
import sys
from pathlib import Path

VERSION = "1.0.0"

PATTERNS = {
    "AWS Access Key": r"\bAKIA[0-9A-Z]{16}\b",
    "GitHub Token": r"\bgh[pousr]_[A-Za-z0-9_]{20,255}\b",
    "Private Key": r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
    "Generic API Key": r"(?i)\b(?:api[_-]?key|apikey)\s*[:=]\s*[\"']?[A-Za-z0-9_\-]{16,}[\"']?",
    "Generic Secret": r"(?i)\b(?:secret|token|password|passwd)\s*[:=]\s*[\"']?[^\s\"']{8,}[\"']?",
}

IGNORED_DIRS = {
    ".git",
    ".venv",
    "venv",
    "node_modules",
    "__pycache__",
    ".idea",
    ".vscode",
}

IGNORED_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif",
    ".ico", ".zip", ".tar", ".gz",
    ".pdf", ".exe", ".dll",
    ".mp3", ".mp4", ".mov",
}


def should_skip(path: Path) -> bool:
    if any(part in IGNORED_DIRS for part in path.parts):
        return True

    if path.suffix.lower() in IGNORED_EXTENSIONS:
        return True

    return False


def scan_file(path: Path):
    findings = []

    try:
        content = path.read_text(
            encoding="utf-8",
            errors="ignore"
        )
    except (PermissionError, OSError):
        return findings

    lines = content.splitlines()

    for line_number, line in enumerate(lines, start=1):
        for name, pattern in PATTERNS.items():
            if re.search(pattern, line):
                findings.append({
                    "file": str(path),
                    "line": line_number,
                    "type": name,
                    "preview": mask_secret(line.strip()),
                })

    return findings


def mask_secret(text: str) -> str:
    if len(text) <= 20:
        return "*" * len(text)

    return text[:8] + "..." + text[-4:]


def scan_directory(root: Path):
    findings = []

    for path in root.rglob("*"):
        if not path.is_file():
            continue

        if should_skip(path):
            continue

        findings.extend(scan_file(path))

    return findings


def print_results(findings):
    if not findings:
        print("\n✓ No suspicious secrets found.")
        return

    print(f"\n⚠ Found {len(findings)} potential secret(s):\n")

    for item in findings:
        print(f"[{item['type']}]")
        print(f"  File   : {item['file']}")
        print(f"  Line   : {item['line']}")
        print(f"  Preview: {item['preview']}")
        print()


def main():
    parser = argparse.ArgumentParser(
        description="SentryVeil - Local secret scanner for developers"
    )

    parser.add_argument(
        "path",
        nargs="?",
        default=".",
        help="Directory or project path to scan"
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"SentryVeil {VERSION}"
    )

    args = parser.parse_args()

    root = Path(args.path).resolve()

    if not root.exists():
        print(f"Error: path does not exist: {root}")
        sys.exit(1)

    print("╔══════════════════════════════════╗")
    print("║          SENTRYVEIL              ║")
    print("║      Local Secret Scanner        ║")
    print("╚══════════════════════════════════╝")

    print(f"\nScanning: {root}\n")

    if root.is_file():
        findings = scan_file(root)
    else:
        findings = scan_directory(root)

    print_results(findings)

    sys.exit(1 if findings else 0)


if __name__ == "__main__":
    main()
